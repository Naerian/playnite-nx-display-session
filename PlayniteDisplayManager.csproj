<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PlayniteDisplayManager</AssemblyName>
    <RootNamespace>PlayniteDisplayManager</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);RestoreHost\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="PlayniteSDK" Version="6.16.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Localization\*.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="media\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Icons\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Examples\*.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
