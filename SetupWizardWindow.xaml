<Window x:Class="PlayniteDisplayManager.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="620" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Narian.Bg}"
        Foreground="{DynamicResource TextBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontSize="14"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnWindowLoaded"
        SizeChanged="OnWindowSizeChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="WizardTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="WizardStepLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <Style x:Key="WizardBody" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <Style x:Key="WizardHint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,8,0,16"/>
            </Style>
            <Style x:Key="WizardFieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="WizardErrorCallout" TargetType="Border">
                <Setter Property="Background" Value="#20E24B4B"/>
                <Setter Property="BorderBrush" Value="#80E24B4B"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="ClipToBounds" Value="True"/>
            </Style>
            <Style x:Key="WizardErrorCalloutAccentBar" TargetType="Border">
                <Setter Property="Width" Value="3"/>
                <Setter Property="Background" Value="#FFE24B4B"/>
            </Style>
            <Style x:Key="WizardErrorCalloutGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                <Setter Property="Foreground" Value="#FFE24B4B"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Margin" Value="0,1,10,0"/>
            </Style>
            <Style x:Key="WizardErrorCalloutTitle" TargetType="TextBlock" BasedOn="{StaticResource WizardBody}">
                <Setter Property="Foreground" Value="#FFE24B4B"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="WizardErrorCalloutBody" TargetType="TextBlock" BasedOn="{StaticResource WizardHint}">
                <Setter Property="Foreground" Value="#FFE24B4B"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style x:Key="WizardSummaryLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="WizardSummaryValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="WizardSummaryRow" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource Narian.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Narian.AccentOn}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Accent}"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Narian.AccentHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Narian.AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource Narian.Border}" BorderThickness="1" CornerRadius="4"
            Background="{DynamicResource Narian.Bg}">
        <DockPanel LastChildFill="True" Margin="24,20">
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" Margin="0,24,0,0">
                <Button x:Name="SkipButton" DockPanel.Dock="Left"
                        HorizontalAlignment="Left" MinWidth="120" Margin="0,0,16,0"
                        Click="SkipClick"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Click="BackClick" MinWidth="100" Margin="0,0,8,0"/>
                    <Button x:Name="NextButton" Style="{StaticResource WizardPrimaryButton}"
                            IsDefault="True" Click="NextClick"/>
                </StackPanel>
                <Border/>
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="560">
                <StackPanel>
                    <Border Background="Transparent" Cursor="SizeAll" Padding="0,0,0,8"
                            MouseLeftButtonDown="OnDragAreaMouseLeftButtonDown">
                        <StackPanel>
                            <TextBlock x:Name="StepLabel" Style="{StaticResource WizardStepLabel}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="StepTitle" Style="{StaticResource WizardTitle}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StepHelp" Style="{StaticResource WizardBody}"/>

                    <StackPanel x:Name="StepWelcome" Visibility="Collapsed">
                        <TextBlock x:Name="WelcomeBody" Style="{StaticResource WizardBody}"/>
                    </StackPanel>

                    <StackPanel x:Name="StepDisplay" Visibility="Collapsed">
                        <TextBlock x:Name="DisplayTargetLabel" Style="{StaticResource WizardFieldLabel}"/>
                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                            <Button x:Name="IdentifyDisplayButton"
                                    DockPanel.Dock="Right"
                                    MinWidth="120"
                                    MinHeight="36"
                                    Margin="8,0,0,0"
                                    Click="IdentifyDisplay_OnClick"/>
                            <ComboBox x:Name="PlayDisplayBox"
                                      MinHeight="36"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"/>
                        </DockPanel>
                        <TextBlock x:Name="IdentifyDisplayHint" Style="{StaticResource WizardHint}" Margin="0,0,0,12"/>
                        <CheckBox x:Name="TurnOffOthersCheck" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TurnOffOthersHelp" Style="{StaticResource WizardHint}"/>
                    </StackPanel>

                    <StackPanel x:Name="StepHdr" Visibility="Collapsed">
                        <Border x:Name="HdrNoSupportCallout"
                                Style="{StaticResource WizardErrorCallout}"
                                Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Style="{StaticResource WizardErrorCalloutAccentBar}"/>
                                <DockPanel Margin="12,10,12,10" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="&#xE7BA;"
                                               Style="{StaticResource WizardErrorCalloutGlyph}"/>
                                    <StackPanel>
                                        <TextBlock x:Name="HdrNoSupportTitle"
                                                   Style="{StaticResource WizardErrorCalloutTitle}"/>
                                        <TextBlock x:Name="HdrNoSupportBody"
                                                   Style="{StaticResource WizardErrorCalloutBody}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="HdrOptionsPanel">
                            <RadioButton x:Name="HdrNoneRadio" GroupName="WizardHdr" Margin="0,0,0,8"/>
                            <RadioButton x:Name="HdrAllRadio" GroupName="WizardHdr" Margin="0,0,0,8"/>
                            <RadioButton x:Name="HdrMetadataRadio" GroupName="WizardHdr" Margin="0,0,0,0"/>
                            <TextBlock x:Name="HdrHelp" Style="{StaticResource WizardHint}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="StepRefresh" Visibility="Collapsed">
                        <RadioButton x:Name="RefreshNativeRadio" GroupName="WizardRefresh" Margin="0,0,0,8"
                                     Checked="RefreshRadio_OnChecked"/>
                        <StackPanel x:Name="RefreshExactPanel"/>
                        <RadioButton x:Name="RefreshHighestRadio" GroupName="WizardRefresh" Margin="0,8,0,0"
                                     Checked="RefreshRadio_OnChecked"/>
                        <TextBlock x:Name="RefreshHelp" Style="{StaticResource WizardHint}"/>
                    </StackPanel>

                    <StackPanel x:Name="StepMigration" Visibility="Collapsed">
                        <TextBlock x:Name="MigrationCountText" Style="{StaticResource WizardBody}"/>
                        <CheckBox x:Name="ClearNativeFlagsCheck" Margin="0,0,0,0"/>
                        <TextBlock x:Name="MigrationHelp" Style="{StaticResource WizardHint}"/>
                    </StackPanel>

                    <StackPanel x:Name="StepSummary" Visibility="Collapsed">
                        <StackPanel x:Name="SummaryRows"/>
                        <TextBlock x:Name="SummaryHelp" Style="{StaticResource WizardHint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
