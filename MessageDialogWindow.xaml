<Window x:Class="PlayniteDisplayManager.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="520" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Narian.Bg}"
        Foreground="{DynamicResource TextBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontSize="14"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnWindowLoaded"
        SizeChanged="OnWindowSizeChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DialogTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="DialogBody" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="22"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="DialogChangeArrow" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.TextMuted}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0"/>
            </Style>
            <Style x:Key="DialogChangeBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
            <Style x:Key="DialogChangeBadgeBefore" TargetType="Border" BasedOn="{StaticResource DialogChangeBadge}">
                <Setter Property="Background" Value="{DynamicResource Narian.BadgeWarningBg}"/>
            </Style>
            <Style x:Key="DialogChangeBadgeAfter" TargetType="Border" BasedOn="{StaticResource DialogChangeBadge}">
                <Setter Property="Background" Value="{DynamicResource Narian.BadgeMutedBg}"/>
            </Style>
            <Style x:Key="DialogChangeBadgeText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.Text}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource Narian.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Narian.AccentOn}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Accent}"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Narian.AccentHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Narian.AccentHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource Narian.Border}" BorderThickness="1" CornerRadius="4"
            Background="{DynamicResource Narian.Bg}">
        <DockPanel LastChildFill="True" Margin="24,20">
            <Button x:Name="OkButton" DockPanel.Dock="Bottom"
                    Style="{StaticResource DialogPrimaryButton}"
                    HorizontalAlignment="Right" Margin="0,24,0,0"
                    IsDefault="True" IsCancel="True" Click="OkClick"/>
            <StackPanel>
                <Border Background="Transparent" Cursor="SizeAll"
                        MouseLeftButtonDown="OnDragAreaMouseLeftButtonDown">
                    <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}"/>
                </Border>
                <TextBlock x:Name="BodyText" Style="{StaticResource DialogBody}"/>
                <StackPanel x:Name="ChangesPanel"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
