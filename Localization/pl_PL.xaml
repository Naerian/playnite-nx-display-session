    <sys:String x:Key="LOCDisplayManager_RestoreLeaseTitle">Test automatycznego przywracania</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseHelp">Zapisuje migawkę bieżących wyświetlaczy i obserwuje Playnite. Jeśli Playnite niespodziewanie się zamknie, migawka zostanie automatycznie przywrócona. Przydatne do sprawdzenia, czy zabezpieczenie działa.</sys:String>
