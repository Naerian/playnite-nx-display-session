    <sys:String x:Key="LOCDisplayManager_TopologyTrialTitle">Ensayo de topología</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialHelp">Aplica temporalmente primario / apagar otras pantallas con restore automático. RestoreHost permanece armado durante el ensayo.</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialTarget">Pantalla objetivo</sys:String>
