    <sys:String x:Key="LOCDisplayManager_HdrTab">HDR</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrHelp">Display Manager es dueño del HDR cuando está instalado. Al salir SIEMPRE ESCRIBE el estado deseado — no confía en la lectura de Windows con Administración automática del color (ACM).</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyTitle">Política HDR global</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyHelp">Por defecto para todos los juegos. El override del menú contextual del juego siempre gana.</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyNone">No gestionar HDR de forma global</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyAllGames">Activar HDR al jugar y escribir HDR off al salir (cualquier juego)</sys:String>
