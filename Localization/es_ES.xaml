    <sys:String x:Key="LOCDisplayManager_TabComingSoon">Esta sección llega en un paso posterior.</sys:String>
    <sys:String x:Key="LOCDisplayManager_AboutBlurb">Aplica un perfil de imagen de Windows al lanzar un juego y restaura el escritorio al salir. Pensado para HTPC / sofá.</sys:String>
    <sys:String x:Key="LOCDisplayManager_VersionAuthorFormat">Display Manager {0} · Narian</sys:String>
