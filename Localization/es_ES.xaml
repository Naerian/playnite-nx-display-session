    <sys:String x:Key="LOCDisplayManager_TopologyTurnOffConfirm">Las otras pantallas se apagarán unos segundos y luego se restaurarán. ¿Continuar?</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialApply">Ensayo 8 s</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialRestoreNow">Restaurar ahora</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialNoTarget">Selecciona primero una pantalla conectada.</sys:String>
