    <sys:String x:Key="LOCDisplayManager_GameHdrForceOn">Force HDR on</sys:String>
    <sys:String x:Key="LOCDisplayManager_GameHdrForceOff">Force HDR off (SDR)</sys:String>
    <sys:String x:Key="LOCDisplayManager_GameHdrDoNotTouch">Do not touch HDR</sys:String>
