    <sys:String x:Key="LOCDisplayManager_RestoreLeaseArmedFormat">Lease armed. Snapshot: {0}. Kill Playnite (or stop heartbeats) to verify host restore. Log: %TEMP%\PlayniteDisplayManager-RestoreHost.log</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseDisarmed">Lease disarmed.</sys:String>
    <sys:String x:Key="LOCDisplayManager_AboutTab">About</sys:String>
    <sys:String x:Key="LOCDisplayManager_TabComingSoon">This section lands in a later step.</sys:String>
    <sys:String x:Key="LOCDisplayManager_AboutBlurb">Applies a Windows display profile when a game starts and restores the desktop when it stops. Built for HTPC / couch setups.</sys:String>
    <sys:String x:Key="LOCDisplayManager_VersionAuthorFormat">Display Manager {0} · Narian</sys:String>
