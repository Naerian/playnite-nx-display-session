    <sys:String x:Key="LOCDisplayManager_HdrTab">HDR</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrHelp">Display Manager owns HDR when installed. On exit it writes the desired state — it does not trust Windows’ own HDR readout.</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyTitle">Global HDR policy</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyHelp">Default for every game. Per-game overrides in the game context menu always win.</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyNone">Do not manage HDR globally</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyAllGames">Enable HDR while playing, write HDR off on exit (any game)</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyMetadata">Enable HDR only when game metadata indicates HDR, write off on exit</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrMetadataTitle">HDR metadata match names</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrMetadataHelp">Comma-separated Feature names (case-insensitive). Works with PCGamingWiki Metadata Provider’s HDR feature. No network on launch.</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrIncludeTags">Also match game tags</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrOverrideCountFormat">{0} game(s) with an HDR override (not inherit).</sys:String>
