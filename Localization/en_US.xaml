    <sys:String x:Key="LOCDisplayManager_OverviewNightLightCut">Not managed — no supported Win10+Win11 Night Light API (experimental cut).</sys:String>
    <sys:String x:Key="LOCDisplayManager_NotificationsTab">Notifications</sys:String>
    <sys:String x:Key="LOCDisplayManager_MaintenanceTab">Maintenance</sys:String>
    <sys:String x:Key="LOCDisplayManager_MaintenanceHelp">Diagnostics, RestoreHost lease, and EnableSystemHdr migration (reversible).</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseTitle">RestoreHost lease test</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseHelp">Captures the current display topology and arms the external RestoreHost without changing displays (fake apply). If Playnite dies or heartbeats stop for 30 seconds, the host reapplies the snapshot.</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseArm">Arm restore lease</sys:String>
