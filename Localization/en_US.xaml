<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="LOCDisplayManager_PluginName">Display Manager</sys:String>
    <sys:String x:Key="LOCDisplayManager_OpenSettings">Open settings</sys:String>
    <sys:String x:Key="LOCDisplayManager_SkeletonHint">Skeleton build. Per-game display and HDR profiles come next.</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewTab">Overview</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewHelp">Review connected displays, HDR ownership, and the active session before changing detailed settings.</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewRefresh">Refresh</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewDisplays">Displays</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewDisplaysPlaceholder">Display enumeration is not wired yet.</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewDisplaysNone">No displays detected.</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewDisplaysFormat">{0} connected · primary: {1}</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewHdr">Windows HDR</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewHdrUnknown">Unknown — Display Manager does not trust readback under Automatic Color Management.</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewPolicy">Global HDR policy</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewPolicyUnset">Not configured yet.</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewSession">Active session</sys:String>
    <sys:String x:Key="LOCDisplayManager_OverviewSessionIdle">No game session.</sys:String>
    <sys:String x:Key="LOCDisplayManager_StatusPending">Pending</sys:String>
    <sys:String x:Key="LOCDisplayManager_StatusUnknown">Unknown</sys:String>
    <sys:String x:Key="LOCDisplayManager_StatusConnected">Connected</sys:String>
    <sys:String x:Key="LOCDisplayManager_StatusDisconnected">Disconnected</sys:String>
    <sys:String x:Key="LOCDisplayManager_StatusPrimary">Primary</sys:String>
    <sys:String x:Key="LOCDisplayManager_IdentityEdid">EDID identity</sys:String>
    <sys:String x:Key="LOCDisplayManager_IdentityConnector">Connector fallback</sys:String>
    <sys:String x:Key="LOCDisplayManager_DisplaysHelp">Rename displays for Playnite. Identity uses EDID when available — never \\.\DISPLAY#.</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialTitle">Topology trial</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialHelp">Temporarily apply primary / other-display changes with an automatic restore. RestoreHost stays armed while the trial runs.</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialTarget">Target display</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyMakePrimary">Make this display primary</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTurnOffOthers">Turn off other displays (opt-in)</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTurnOffOthersWarning">Never leaves you with zero screens. Confirm before applying.</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTurnOffConfirm">Other displays will turn off for a few seconds, then restore automatically. Continue?</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialApply">Apply 8s trial</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialRestoreNow">Restore now</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialNoTarget">Select a connected display first.</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialNothing">Enable make primary and/or turn off others.</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialAppliedFormat">Applied ({0}). Restoring in {1}s…</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialCountdownFormat">Restoring in {0}s…</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialRestored">Desktop topology restored.</sys:String>
    <sys:String x:Key="LOCDisplayManager_TopologyTrialNothingToRestore">No trial snapshot to restore.</sys:String>
    <sys:String x:Key="LOCDisplayManager_DisplayAlias">Custom name</sys:String>
    <sys:String x:Key="LOCDisplayManager_DisplayAliasHelp">Optional Playnite name. Disconnected displays with a custom name stay listed.</sys:String>
    <sys:String x:Key="LOCDisplayManager_DisplayShowInList">Show in Display Manager</sys:String>
    <sys:String x:Key="LOCDisplayManager_AppearancePreset">Appearance</sys:String>
    <sys:String x:Key="LOCDisplayManager_AppearancePresetHelp">Presets change colors only. Layout, type scale, and spacing stay fixed.</sys:String>
    <sys:String x:Key="LOCDisplayManager_PresetMidnight">Midnight</sys:String>
    <sys:String x:Key="LOCDisplayManager_PresetPaper">Paper</sys:String>
    <sys:String x:Key="LOCDisplayManager_PresetOled">OLED</sys:String>
    <sys:String x:Key="LOCDisplayManager_PresetOcean">Ocean</sys:String>
    <sys:String x:Key="LOCDisplayManager_PresetEmber">Ember</sys:String>
    <sys:String x:Key="LOCDisplayManager_DisplaysTab">Displays</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrTab">HDR</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrHelp">Display Manager owns HDR when installed. Exit always WRITES the desired state — it does not trust Windows readback under Automatic Color Management (ACM).</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyTitle">Global HDR policy</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyHelp">One policy for all games. Per-game overrides arrive in a later step.</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyNone">Do not manage HDR globally</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyAllGames">Enable HDR while playing, write HDR off on exit (any game)</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyMetadata">Enable HDR only when game metadata indicates HDR, write off on exit</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrPolicyMetadataHint">Metadata matching lands in the next step. Selecting this now stores the preference only.</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrAcmTitle">ACM and diagnostics</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrAcmHelp">Windows 11 Automatic Color Management can make HDR status readbacks lie. Prefer Win+Alt+B as a visual check. Use Write HDR off to force SDR by write.</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrWriteOffNow">Write HDR off now</sys:String>
    <sys:String x:Key="LOCDisplayManager_HdrWriteOffOk">HDR off was written to capable displays (no readback trust).</sys:String>
    <sys:String x:Key="LOCDisplayManager_GeneralTab">General</sys:String>
    <sys:String x:Key="LOCDisplayManager_NotificationsTab">Notifications</sys:String>
    <sys:String x:Key="LOCDisplayManager_MaintenanceTab">Maintenance</sys:String>
    <sys:String x:Key="LOCDisplayManager_MaintenanceHelp">Diagnostics and restore-lease tools. Backup/export arrives in a later step.</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseTitle">RestoreHost lease test</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseHelp">Captures the current display topology and arms the external RestoreHost without changing displays (fake apply). If Playnite dies or heartbeats stop for 30 seconds, the host reapplies the snapshot.</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseArm">Arm restore lease</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseDisarm">Disarm</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseArmedFormat">Lease armed. Snapshot: {0}. Kill Playnite (or stop heartbeats) to verify host restore. Log: %TEMP%\PlayniteDisplayManager-RestoreHost.log</sys:String>
    <sys:String x:Key="LOCDisplayManager_RestoreLeaseDisarmed">Lease disarmed.</sys:String>
    <sys:String x:Key="LOCDisplayManager_AboutTab">About</sys:String>
    <sys:String x:Key="LOCDisplayManager_TabComingSoon">This section lands in a later step.</sys:String>
    <sys:String x:Key="LOCDisplayManager_AboutBlurb">Applies a Windows display profile when a game starts and restores the desktop when it stops. Built for HTPC / couch setups.</sys:String>
    <sys:String x:Key="LOCDisplayManager_VersionAuthorFormat">Display Manager {0} · Narian</sys:String>
</ResourceDictionary>
