    <sys:String x:Key="LOCDisplayManager_NightLightTitle">Night Light</sys:String>
    <sys:String x:Key="LOCDisplayManager_NightLightExperimentalBadge">Experimental — cut in this version</sys:String>
    <sys:String x:Key="LOCDisplayManager_NightLightCutHelp">Windows does not expose a supported Night Light API that works reliably on both Windows 10 and Windows 11. Undocumented CloudStore registry writes can leave Night Light broken until you sign out. Display Manager therefore does not turn Night Light off (or on) during games. Use Windows Settings if you need to change it.</sys:String>
    <sys:String x:Key="LOCDisplayManager_NightLightDoNotTouch">Do not touch Night Light</sys:String>
    <sys:String x:Key="LOCDisplayManager_RefreshRateTitle">Refresh rate (Hz)</sys:String>
    <sys:String x:Key="LOCDisplayManager_RefreshRateHelp">Optional. Changes only the primary display’s refresh rate at the current resolution (does not change resolution). Restored from the topology snapshot when the game stops.</sys:String>
    <sys:String x:Key="LOCDisplayManager_RefreshPolicyNative">Native — do not change refresh rate</sys:String>
