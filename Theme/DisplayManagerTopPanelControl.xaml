<playnite:PluginUserControl x:Class="PlayniteDisplayManager.Theme.DisplayManagerTopPanelControl"
                            x:Name="Root"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                            Focusable="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip="{Binding TopPanelTooltip}">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="28" MinHeight="28">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Viewbox Width="20" Height="20" Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     SnapsToDevicePixels="True">
                <Viewbox.Style>
                    <Style TargetType="Viewbox">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowTopPanelIcon}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowTopPanelIcon}" Value="True" />
                                    <Condition Binding="{Binding ShowTopPanelText}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Margin" Value="0,0,6,0" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Viewbox.Style>
                <Path x:Name="IconPath"
                      Stretch="Uniform"
                      Fill="{Binding Foreground, ElementName=Root}"
                      RenderTransformOrigin="0.5,0.5">
                    <!-- Potrace SVG paths are Y-up; WPF is Y-down without the SVG group transform. -->
                    <Path.RenderTransform>
                        <ScaleTransform ScaleY="-1" />
                    </Path.RenderTransform>
                </Path>
            </Viewbox>
            <TextBlock Text="{Binding PrimaryDisplayAlias}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="13"
                       MaxWidth="140"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{Binding Foreground, ElementName=Root}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowTopPanelText}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</playnite:PluginUserControl>
