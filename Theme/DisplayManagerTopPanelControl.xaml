<playnite:PluginUserControl x:Class="PlayniteDisplayManager.Theme.DisplayManagerTopPanelControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                            Focusable="False"
                            ToolTip="{Binding TopPanelTooltip}">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
        <TextBlock FontFamily="Segoe MDL2 Assets"
                   Text="&#xE7F4;"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTopPanelIcon}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding PrimaryDisplayAlias}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   FontSize="13"
                   MaxWidth="140"
                   TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTopPanelText}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</playnite:PluginUserControl>
