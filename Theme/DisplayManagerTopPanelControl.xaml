<playnite:PluginUserControl x:Class="PlayniteDisplayManager.Theme.DisplayManagerTopPanelControl"
                            x:Name="Root"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                            Focusable="False"
                            ToolTip="{Binding TopPanelTooltip}">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
        <Viewbox Width="20" Height="20" Margin="2,0,5,0" Stretch="Uniform"
                 VerticalAlignment="Center">
            <Viewbox.Style>
                <Style TargetType="Viewbox">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTopPanelIcon}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Viewbox.Style>
            <Path x:Name="IconPath"
                  Stretch="Uniform"
                  Fill="{Binding Foreground, ElementName=Root}">
                <!-- Potrace SVG paths are Y-up; WPF is Y-down without the SVG group transform. -->
                <Path.LayoutTransform>
                    <ScaleTransform ScaleY="-1" />
                </Path.LayoutTransform>
            </Path>
        </Viewbox>
        <TextBlock Text="{Binding PrimaryDisplayAlias}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   FontSize="13"
                   MaxWidth="140"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{Binding Foreground, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTopPanelText}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</playnite:PluginUserControl>
