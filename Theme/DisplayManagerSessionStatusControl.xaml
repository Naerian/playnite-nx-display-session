<playnite:PluginUserControl x:Class="PlayniteDisplayManager.Theme.DisplayManagerSessionStatusControl"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                            Focusable="False">
    <StackPanel>
        <TextBlock FontWeight="SemiBold">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Display session idle" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SessionActive}" Value="True">
                            <Setter Property="Text" Value="Display session active" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding SessionGameName}" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0" />
    </StackPanel>
</playnite:PluginUserControl>
