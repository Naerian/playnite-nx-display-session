                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE946;" />
                        <TextBlock Text="{DynamicResource LOCDisplayManager_AboutTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCDisplayManager_AboutTab}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCDisplayManager_AboutDescription}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>

                        <TextBlock x:Name="AboutVersionText"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16" />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeaderBorder}">
                                    <TextBlock Text="{DynamicResource LOCDisplayManager_AboutPurposeTitle}" Style="{StaticResource SectionHeaderText}" />
                                </Border>
                                <TextBlock Text="{DynamicResource LOCDisplayManager_AboutDisplays}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource LOCDisplayManager_AboutProfiles}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource LOCDisplayManager_AboutIntegration}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Style="{StaticResource PageSection}" Margin="0,0,0,16">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCDisplayManager_ProjectLinksTitle}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="{DynamicResource LOCDisplayManager_OpenGitHub}"
                                            Tag="https://github.com/Naerian/playnite-nx-display-session"
                                            MinWidth="100"
                                            Margin="0,0,8,8"
                                            Click="OpenExternalButton" />
                                    <Button Content="{DynamicResource LOCDisplayManager_OpenWiki}"
                                            Tag="https://github.com/Naerian/playnite-nx-display-session/wiki"
                                            MinWidth="100"
                                            Margin="0,0,8,8"
                                            Click="OpenExternalButton" />
                                    <Button Content="{DynamicResource LOCDisplayManager_ReportIssue}"
                                            Tag="https://github.com/Naerian/playnite-nx-display-session/issues/new"
                                            MinWidth="140"
                                            Margin="0,0,0,8"
                                            Click="OpenExternalButton" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Style="{StaticResource PageSection}" Margin="0,0,0,16">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCDisplayManager_SupportTitle}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                </StackPanel>
                                <Button Content="{DynamicResource LOCDisplayManager_KoFiSupport}"
                                        Tag="https://ko-fi.com/naerian"
                                        HorizontalAlignment="Left"
                                        MinWidth="150"
                                        Padding="16,8"
                                        Click="OpenExternalButton" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
