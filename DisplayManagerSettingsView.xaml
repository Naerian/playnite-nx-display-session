<UserControl x:Class="PlayniteDisplayManager.DisplayManagerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinWidth="980"
             MinHeight="640"
             d:DesignHeight="780"
             d:DesignWidth="1100"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             FontSize="14"
             TextElement.FontSize="14"
             TextElement.Foreground="{DynamicResource TextBrush}"
             Background="{DynamicResource Narian.Bg}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsChrome.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeaderBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="0,0,0,8" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="PageHeader" TargetType="Border" BasedOn="{StaticResource SectionHeaderBorder}" />
            <Style x:Key="SectionHeaderText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="20" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,8,0,16" />
            </Style>
            <Style x:Key="SectionSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="FontStyle" Value="Italic" />
                <Setter Property="Opacity" Value="0.78" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="PageSection" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,24" />
            </Style>
            <Style x:Key="FieldGroup" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="IndentedHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                <Setter Property="Margin" Value="24,8,0,16" />
            </Style>
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,24" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <Style x:Key="SummaryCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="MinHeight" Value="92" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <Style x:Key="DeviceCard" TargetType="Border" BasedOn="{StaticResource SummaryCard}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <Style x:Key="SummaryCardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SummaryTitleSeparator" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="0,0,0,8" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="SummaryCardValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="SummaryPill" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Narian.BadgeBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                </Style.Resources>
            </Style>
            <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
            <Style x:Key="DeviceStatusPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>
            <Style x:Key="CapabilityPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>
            <Style x:Key="SummaryMetricPill" TargetType="Border" BasedOn="{StaticResource CapabilityPill}" />
            <Style x:Key="NarianPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource Narian.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Narian.AccentOn}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Accent}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Narian.AccentHover}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Narian.AccentHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FillScrollViewer" TargetType="ScrollViewer">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            </Style>
            <Style x:Key="TabGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style x:Key="TabHeaderLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="TopTabItem" TargetType="TabItem">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinWidth" Value="148" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid ClipToBounds="False" TextElement.Foreground="{TemplateBinding Foreground}">
                                <Rectangle x:Name="TabFill" RadiusX="4" RadiusY="4" Fill="Transparent" />
                                <ContentPresenter x:Name="Header" ContentSource="Header"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="16,8"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabFill" Property="Fill" Value="{DynamicResource Narian.Selected}" />
                                    <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TopTabs" TargetType="TabControl">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource TopTabItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                        Padding="6" ClipToBounds="False"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <WrapPanel x:Name="HeaderPanel" IsItemsHost="True" />
                                </Border>
                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="16,16">
        <TabControl x:Name="RootTabs" Style="{StaticResource TopTabs}" SelectionChanged="RootTabsSelectionChanged">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE80F;" />
                        <TextBlock Text="{DynamicResource LOCDisplayManager_OverviewTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Content="{DynamicResource LOCDisplayManager_OverviewRefresh}"
                                            Style="{StaticResource NarianPrimaryButton}"
                                            MinWidth="130"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Click="RefreshOverview_OnClick" />
                                    <TextBlock Text="{DynamicResource LOCDisplayManager_OverviewTab}"
                                               Style="{StaticResource SectionHeaderText}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource LOCDisplayManager_OverviewHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCDisplayManager_AppearancePreset}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{DynamicResource LOCDisplayManager_AppearancePresetHelp}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                                <WrapPanel x:Name="AppearancePresetChips" Orientation="Horizontal" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource SummaryCard}" Margin="0,0,8,16">
                                <StackPanel>
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                        <TextBlock Text="{DynamicResource LOCDisplayManager_OverviewDisplays}" Style="{StaticResource SummaryCardTitle}" />
                                    </Border>
                                    <TextBlock x:Name="OverviewDisplaysText" Style="{StaticResource SummaryCardValue}" />
                                    <WrapPanel x:Name="OverviewDisplayPills" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}" Margin="8,0,0,16">
                                <StackPanel>
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                        <DockPanel LastChildFill="True">
                                            <Border x:Name="OverviewSessionStatusPill" DockPanel.Dock="Right" Style="{StaticResource StatusPill}">
                                                <TextBlock x:Name="OverviewSessionStatusText" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource LOCDisplayManager_OverviewSession}" Style="{StaticResource SummaryCardTitle}" />
                                        </DockPanel>
                                    </Border>
                                    <TextBlock x:Name="OverviewSessionText" Style="{StaticResource SummaryCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}" Margin="0,0,8,16">
                                <StackPanel>
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                        <TextBlock Text="{DynamicResource LOCDisplayManager_OverviewWhenLaunching}" Style="{StaticResource SummaryCardTitle}" />
                                    </Border>
                                    <TextBlock x:Name="OverviewPolicyText" Style="{StaticResource SummaryCardValue}" />
                                    <WrapPanel x:Name="OverviewPolicyPills" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}" Margin="8,0,0,16">
                                <StackPanel>
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                        <DockPanel LastChildFill="True">
                                            <Border x:Name="OverviewNativeHdrStatusPill" DockPanel.Dock="Right" Style="{StaticResource StatusPill}">
                                                <TextBlock x:Name="OverviewNativeHdrStatusText" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource LOCDisplayManager_OverviewNativeHdr}" Style="{StaticResource SummaryCardTitle}" />
                                        </DockPanel>
                                    </Border>
                                    <TextBlock x:Name="OverviewNativeHdrText" Style="{StaticResource SummaryCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}" Margin="0,0,8,0" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <Border Style="{StaticResource SummaryTitleSeparator}">
                                        <TextBlock Text="{DynamicResource LOCDisplayManager_OverviewRefreshRate}" Style="{StaticResource SummaryCardTitle}" />
                                    </Border>
                                    <TextBlock x:Name="OverviewRefreshRateText" Style="{StaticResource SummaryCardValue}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE7F4;" />
                        <TextBlock Text="{DynamicResource LOCDisplayManager_DisplaysTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Content="{DynamicResource LOCDisplayManager_OverviewRefresh}"
                                            Style="{StaticResource NarianPrimaryButton}"
                                            MinWidth="130"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Click="RefreshDisplays_OnClick" />
                                    <TextBlock Text="{DynamicResource LOCDisplayManager_DisplaysTab}"
                                               Style="{StaticResource SectionHeaderText}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource LOCDisplayManager_DisplaysHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="{DynamicResource LOCDisplayManager_TopologyTrialTitle}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_TopologyTrialHelp}" Style="{StaticResource HintText}" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_TopologyTrialTarget}" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <ComboBox x:Name="TopologyTargetBox"
                                      MinHeight="36"
                                      DisplayMemberPath="EffectiveName"
                                      SelectedValuePath="Id" />
                            <CheckBox x:Name="TopologyMakePrimaryCheck"
                                      Content="{DynamicResource LOCDisplayManager_TopologyMakePrimary}"
                                      IsChecked="True"
                                      Margin="0,12,0,0" />
                            <CheckBox x:Name="TopologyTurnOffOthersCheck"
                                      Content="{DynamicResource LOCDisplayManager_TopologyTurnOffOthers}"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_TopologyTurnOffOthersWarning}"
                                       Style="{StaticResource IndentedHintText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{DynamicResource LOCDisplayManager_TopologyTrialApply}"
                                        Style="{StaticResource NarianPrimaryButton}"
                                        MinWidth="180"
                                        Margin="0,0,8,0"
                                        Click="TopologyTrialApply_OnClick" />
                                <Button Content="{DynamicResource LOCDisplayManager_TopologyTrialRestoreNow}"
                                        MinWidth="140"
                                        MinHeight="36"
                                        Click="TopologyTrialRestore_OnClick" />
                            </StackPanel>
                            <TextBlock x:Name="TopologyTrialStatusText"
                                       Style="{StaticResource HintText}"
                                       Margin="0,12,0,0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource PageSection}" Margin="0,8,0,8">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCDisplayManager_DisplaysListTitle}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCDisplayManager_DisplaysListHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <StackPanel x:Name="DisplayCardsPanel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE793;" />
                        <TextBlock Text="{DynamicResource LOCDisplayManager_HdrTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <Border Style="{StaticResource PageHeader}">
                            <TextBlock Text="{DynamicResource LOCDisplayManager_HdrTab}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCDisplayManager_HdrHelp}" Style="{StaticResource SectionSubtitleText}" />

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="{DynamicResource LOCDisplayManager_HdrPolicyTitle}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_HdrPolicyHelp}" Style="{StaticResource HintText}" />
                            <RadioButton x:Name="HdrPolicyNoneRadio"
                                         GroupName="HdrPolicy"
                                         Content="{DynamicResource LOCDisplayManager_HdrPolicyNone}"
                                         Margin="0,8,0,0"
                                         Checked="HdrPolicyRadio_OnChecked" />
                            <RadioButton x:Name="HdrPolicyAllRadio"
                                         GroupName="HdrPolicy"
                                         Content="{DynamicResource LOCDisplayManager_HdrPolicyAllGames}"
                                         Margin="0,8,0,0"
                                         Checked="HdrPolicyRadio_OnChecked" />
                            <RadioButton x:Name="HdrPolicyMetadataRadio"
                                         GroupName="HdrPolicy"
                                         Content="{DynamicResource LOCDisplayManager_HdrPolicyMetadata}"
                                         Margin="0,8,0,0"
                                         Checked="HdrPolicyRadio_OnChecked" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="{DynamicResource LOCDisplayManager_HdrMetadataTitle}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_HdrMetadataHelp}" Style="{StaticResource HintText}" />
                            <TextBox x:Name="HdrMetadataNamesBox"
                                     MinHeight="36"
                                     Margin="0,4,0,0"
                                     VerticalContentAlignment="Center"
                                     LostFocus="HdrMetadataNamesBox_OnLostFocus" />
                            <CheckBox x:Name="HdrIncludeTagsCheck"
                                      Content="{DynamicResource LOCDisplayManager_HdrIncludeTags}"
                                      Margin="0,12,0,0"
                                      Checked="HdrIncludeTagsCheck_OnChanged"
                                      Unchecked="HdrIncludeTagsCheck_OnChanged" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_HdrIncludeTagsHelp}"
                                       Style="{StaticResource IndentedHintText}" />
                            <TextBlock x:Name="HdrOverrideCountText"
                                       Style="{StaticResource HintText}"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_HdrGameMenuHint}"
                                       Style="{StaticResource HintText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="{DynamicResource LOCDisplayManager_HdrForceSdrTitle}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_HdrForceSdrHelp}" Style="{StaticResource HintText}" />
                            <Button Content="{DynamicResource LOCDisplayManager_HdrWriteOffNow}"
                                    Style="{StaticResource NarianPrimaryButton}"
                                    MinWidth="220"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"
                                    Click="HdrWriteOffNow_OnClick" />
                            <TextBlock x:Name="HdrStatusText"
                                       Style="{StaticResource HintText}"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE8F1;" />
                        <TextBlock Text="{DynamicResource LOCDisplayManager_GameProfilesTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCDisplayManager_GameProfilesTitle}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCDisplayManager_GameProfilesHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <TextBlock x:Name="NoGameProfilesText"
                                   Text="{DynamicResource LOCDisplayManager_NoConfiguredGameProfiles}"
                                   Style="{StaticResource HintText}" />
                        <StackPanel x:Name="GameProfileRowsPanel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE713;" />
                        <TextBlock Text="{DynamicResource LOCDisplayManager_GeneralTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <Border Style="{StaticResource PageHeader}">
                            <TextBlock Text="{DynamicResource LOCDisplayManager_GeneralTab}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCDisplayManager_GeneralHelp}" Style="{StaticResource SectionSubtitleText}" />

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="{DynamicResource LOCDisplayManager_DesktopAccessTitle}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_DesktopAccessHelp}" Style="{StaticResource HintText}" />
                            <CheckBox x:Name="ShowDesktopTopPanelCheck"
                                      Content="{DynamicResource LOCDisplayManager_ShowDesktopTopPanel}"
                                      Margin="0,8,0,0"
                                      Checked="ShowDesktopTopPanelCheck_OnChanged"
                                      Unchecked="ShowDesktopTopPanelCheck_OnChanged" />
                            <StackPanel Margin="24,16,0,0"
                                        IsEnabled="{Binding ShowDesktopTopPanel}">
                                <TextBlock Text="{DynamicResource LOCDisplayManager_TopPanelDisplayMode}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding DesktopTopPanelDisplayModeOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding DesktopTopPanelDisplayModeValue, Mode=TwoWay}"
                                          MinHeight="36" />
                                <TextBlock Text="{DynamicResource LOCDisplayManager_TopPanelDisplayModeHelp}"
                                           Style="{StaticResource HintText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="{DynamicResource LOCDisplayManager_AudioSwitcherTitle}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_AudioSwitcherHelp}" Style="{StaticResource HintText}" />
                            <TextBlock x:Name="AudioSwitcherStatusText"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,0,0,8" />
                            <CheckBox x:Name="EnableAudioSwitcherHookCheck"
                                      Content="{DynamicResource LOCDisplayManager_EnableAudioSwitcherHook}"
                                      Margin="0,8,0,0"
                                      Checked="EnableAudioSwitcherHookCheck_OnChanged"
                                      Unchecked="EnableAudioSwitcherHookCheck_OnChanged" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_AudioSwitcherGameMenuHint}"
                                       Style="{StaticResource HintText}"
                                       Margin="0,12,0,0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <TextBlock Text="{DynamicResource LOCDisplayManager_RefreshRateTitle}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_RefreshRateHelp}" Style="{StaticResource HintText}" />
                            <TextBlock x:Name="RefreshRateDetectedText"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,0,0,8" />
                            <RadioButton x:Name="RefreshPolicyNativeRadio"
                                         GroupName="RefreshRatePolicy"
                                         Tag="Native"
                                         Content="{DynamicResource LOCDisplayManager_RefreshPolicyNative}"
                                         Margin="0,8,0,0"
                                         Checked="RefreshRateRadio_OnChecked" />
                            <StackPanel x:Name="RefreshRateExactPanel" />
                            <RadioButton x:Name="RefreshPolicyHighestRadio"
                                         GroupName="RefreshRatePolicy"
                                         Tag="HighestDetected"
                                         Content="{DynamicResource LOCDisplayManager_RefreshPolicyHighest}"
                                         Margin="0,8,0,0"
                                         Checked="RefreshRateRadio_OnChecked" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_RefreshRateGameMenuHint}"
                                       Style="{StaticResource HintText}"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE7E7;" />
                        <TextBlock Text="{DynamicResource LOCDisplayManager_NotificationsTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCDisplayManager_NotificationsTab}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroup}">
                            <CheckBox Content="{DynamicResource LOCDisplayManager_ShowNotifications}"
                                      IsChecked="{Binding ShowNotifications}" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_ShowNotificationsHelp}"
                                       Style="{StaticResource IndentedHintText}" />
                        </StackPanel>

                        <StackPanel Margin="24,0,0,0"
                                    IsEnabled="{Binding ShowNotifications}">
                            <CheckBox Content="{DynamicResource LOCDisplayManager_NotifyNativeHdrConflict}"
                                      IsChecked="{Binding NotifyNativeHdrConflict}" />
                            <TextBlock Text="{DynamicResource LOCDisplayManager_NotifyNativeHdrConflictHelp}"
                                       Style="{StaticResource IndentedHintText}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE90F;" />
                        <TextBlock Text="{DynamicResource LOCDisplayManager_MaintenanceTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <Border Style="{StaticResource PageHeader}">
                            <TextBlock Text="{DynamicResource LOCDisplayManager_MaintenanceTab}" Style="{StaticResource SectionHeaderText}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCDisplayManager_MaintenanceHelp}" Style="{StaticResource SectionSubtitleText}" />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCDisplayManager_NativeHdrMigrationTitle}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{DynamicResource LOCDisplayManager_NativeHdrMigrationHelp}" Style="{StaticResource HintText}" />
                                <TextBlock x:Name="NativeHdrMigrationStatusText"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{DynamicResource LOCDisplayManager_NativeHdrClearNow}"
                                            Style="{StaticResource NarianPrimaryButton}"
                                            MinWidth="180"
                                            Margin="0,0,8,0"
                                            Click="NativeHdrClearNow_OnClick" />
                                    <Button Content="{DynamicResource LOCDisplayManager_NativeHdrRestoreBackup}"
                                            MinWidth="180"
                                            MinHeight="36"
                                            Margin="0,0,8,0"
                                            Click="NativeHdrRestore_OnClick" />
                                    <Button Content="{DynamicResource LOCDisplayManager_OpenSetupWizard}"
                                            MinWidth="160"
                                            MinHeight="36"
                                            Click="OpenSetupWizard_OnClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCDisplayManager_RestoreLeaseTitle}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{DynamicResource LOCDisplayManager_RestoreLeaseHelp}" Style="{StaticResource HintText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{DynamicResource LOCDisplayManager_RestoreLeaseArm}"
                                            Style="{StaticResource NarianPrimaryButton}"
                                            MinWidth="160"
                                            Margin="0,0,8,0"
                                            Click="ArmRestoreLease_OnClick" />
                                    <Button Content="{DynamicResource LOCDisplayManager_RestoreLeaseDisarm}"
                                            MinWidth="160"
                                            MinHeight="36"
                                            Click="DisarmRestoreLease_OnClick" />
                                </StackPanel>
                                <TextBlock x:Name="RestoreLeaseStatusText"
                                           Style="{StaticResource HintText}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE946;" />
                        <TextBlock Text="{DynamicResource LOCDisplayManager_AboutTab}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCDisplayManager_AboutTab}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCDisplayManager_AboutDescription}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>

                        <TextBlock x:Name="AboutVersionText"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16" />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeaderBorder}">
                                    <TextBlock Text="{DynamicResource LOCDisplayManager_AboutPurposeTitle}" Style="{StaticResource SectionHeaderText}" />
                                </Border>
                                <TextBlock Text="{DynamicResource LOCDisplayManager_AboutDisplays}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource LOCDisplayManager_AboutProfiles}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource LOCDisplayManager_AboutIntegration}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Style="{StaticResource PageSection}" Margin="0,0,0,16">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCDisplayManager_ProjectLinksTitle}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="{DynamicResource LOCDisplayManager_OpenGitHub}"
                                            Tag="https://github.com/Naerian/playnite-nx-display-session"
                                            MinWidth="100"
                                            Margin="0,0,8,8"
                                            Click="OpenExternalButton" />
                                    <Button Content="{DynamicResource LOCDisplayManager_OpenWiki}"
                                            Tag="https://github.com/Naerian/playnite-nx-display-session/wiki"
                                            MinWidth="100"
                                            Margin="0,0,8,8"
                                            Click="OpenExternalButton" />
                                    <Button Content="{DynamicResource LOCDisplayManager_ReportIssue}"
                                            Tag="https://github.com/Naerian/playnite-nx-display-session/issues/new"
                                            MinWidth="140"
                                            Margin="0,0,0,8"
                                            Click="OpenExternalButton" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Style="{StaticResource PageSection}" Margin="0,0,0,16">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCDisplayManager_SupportTitle}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                </StackPanel>
                                <Button Content="{DynamicResource LOCDisplayManager_KoFiSupport}"
                                        Tag="https://ko-fi.com/naerian"
                                        HorizontalAlignment="Left"
                                        MinWidth="150"
                                        Padding="16,8"
                                        Click="OpenExternalButton" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
