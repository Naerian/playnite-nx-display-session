<UserControl x:Class="PlayniteDisplayManager.DisplayManagerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720"
             MinHeight="480">
    <Grid Margin="16">
        <StackPanel VerticalAlignment="Top">
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="{DynamicResource LOCDisplayManager_PluginName}" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Text="{DynamicResource LOCDisplayManager_SkeletonHint}" />
        </StackPanel>
    </Grid>
</UserControl>
